# Copy this file to .env and fill in values.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Frontend base URL, used in candidate invite links
APP_URL=http://localhost:3000

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=24

# Key from https://platform.openai.com/api-keys (used to generate interview questions)
OPENAI_API_KEY=
# Defaults to gpt-4.1-mini
OPENAI_MODEL=

# Free key from https://console.groq.com/keys (used to evaluate interviews)
GROQ_API_KEY=
GROQ_MODEL=

# Same LiveKit project as interview-agent/.env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=interviewer

# Shared secret the voice agent sends (x-agent-secret) when posting transcripts. Same value in the agent's .env.local.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# Added in later steps:
# DATABASE_URL=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
